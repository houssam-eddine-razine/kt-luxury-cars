generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VehicleCategory {
  ECONOMY
  COMPACT
  SUV
  PREMIUM
  LUXURY
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  RENTED
  MAINTENANCE
  INACTIVE
}

enum Transmission {
  AUTOMATIC
  MANUAL
}

enum FuelType {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
}

enum FuelPolicy {
  FULL_TO_FULL
  SAME_TO_SAME
  PREPURCHASE
}

enum ReservationStatus {
  NEW
  CONTACTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Vehicle {
  id           String          @id @default(uuid()) @db.Uuid
  slug         String          @unique
  brand        String
  model        String
  trim         String?
  year         Int
  registration String          @unique
  category     VehicleCategory
  status       VehicleStatus   @default(AVAILABLE)
  transmission Transmission
  fuelType     FuelType

  seats   Int @default(5)
  doors   Int @default(5)
  luggage Int @default(2)
  mileage Int @default(0)

  dailyPrice   Int
  weeklyPrice  Int?
  monthlyPrice Int?
  deposit      Int?

  descriptionFr String?
  descriptionEn String?
  descriptionAr String?

  visible  Boolean @default(true)
  featured Boolean @default(false)

  images              VehicleImage[]
  reservationRequests ReservationRequest[]

  rentalPolicyId String?       @db.Uuid
  rentalPolicy   RentalPolicy? @relation(fields: [rentalPolicyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([visible, featured])
  @@index([rentalPolicyId])
}

model VehicleImage {
  id          String  @id @default(uuid()) @db.Uuid
  url         String
  storagePath String?
  altText     String?
  position    Int     @default(0)
  isCover     Boolean @default(false)

  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([vehicleId])
  @@index([vehicleId, position])
}

model RentalPolicy {
  id        String  @id @default(uuid()) @db.Uuid
  name      String
  isDefault Boolean @default(false)
  active    Boolean @default(true)

  minimumDriverAge    Int?
  minimumLicenseYears Int?

  dailyMileageLimit   Int?
  extraKilometrePrice Int?

  fuelPolicy FuelPolicy?

  insuranceIncluded Boolean?
  insuranceDetails  String?
  insuranceExcess   Int?

  airportDeliveryFee Int?

  cancellationPolicy String?
  acceptedPayments   String?
  requiredDocuments  String?

  vehicles Vehicle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDefault, active])
}

model ReservationRequest {
  id        String            @id @default(uuid()) @db.Uuid
  reference String            @unique
  status    ReservationStatus @default(NEW)

  customerName String
  phone        String
  email        String?

  locale           String @default("en")
  deliveryLocation String

  pickupDate DateTime @db.Date
  returnDate DateTime @db.Date

  advertisedDailyRate Int

  customerMessage String?
  internalNotes   String?

  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([vehicleId])
  @@index([pickupDate, returnDate])
  @@index([phone])
}
